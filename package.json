{
  "name": "toefl-practice-system",
  "version": "1.4.0",
  "description": "A focused TOEFL iBT practice and mock exam app.",
  "main": "electron/main.js",
  "type": "module",
  "productName": "TOEFL iBT Practice",
  "author": "anton-bis",
  "license": "MIT",
  "scripts": {
    "dev": "npm run content:manifest && vite",
    "content:manifest": "node scripts/generate-question-manifest.js",
    "build": "npm run content:manifest && vite build && node scripts/check-bundle-size.js",
    "preview": "vite preview",
    "start": "vite --host",
    "test": "node --test tests/content/content.test.js tests/electron/*.test.js && vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/vue src/content electron --ext .js,.cjs,.vue",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "clean": "rm -rf dist build node_modules",
    "electron:dev": "cross-env ELECTRON=true npm run build && electron electron/main.js",
    "electron:build": "cross-env ELECTRON=true npm run build && node scripts/obfuscate.js && electron-builder",
    "electron:pack": "cross-env ELECTRON=true npm run build && node scripts/obfuscate.js && electron-builder --dir",
    "electron:build-only": "cross-env ELECTRON=true npm run build",
    "obfuscate": "node scripts/obfuscate.js",
    "build:obfuscated": "cross-env ELECTRON=true npm run build && node scripts/obfuscate.js"
  },
  "keywords": [
    "toefl",
    "practice",
    "exam",
    "education",
    "frontend",
    "javascript"
  ],
  "dependencies": {
    "electron-updater": "^6.0.0"
  },
  "overrides": {
    "fast-uri": "3.1.3",
    "form-data": "4.0.6",
    "js-yaml": "4.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/roboto": "^5.2.10",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^7.0.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.33.0",
    "fake-indexeddb": "^6.2.5",
    "javascript-obfuscator": "^4.2.2",
    "jsdom": "^24.1.3",
    "pinia": "^3.0.4",
    "prettier": "^3.1.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anton-bis/toefl-app"
  },
  "bugs": {
    "url": "https://github.com/anton-bis/toefl-app/issues"
  },
  "homepage": "https://github.com/anton-bis/toefl-app#readme",
  "build": {
    "appId": "com.yourcompany.toeflpracticesystem",
    "productName": "TOEFL iBT Practice",
    "directories": {
      "output": "release"
    },
    "files": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/electron",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      },
      "package.json"
    ],
    "mac": {
      "identity": null,
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icons/icon.png",
      "artifactName": "toefl-practice-system-${version}-mac.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/icon.ico",
      "artifactName": "${name}-setup-${version}.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/dist/assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "anton-bis",
      "repo": "toefl-app"
    }
  }
}
