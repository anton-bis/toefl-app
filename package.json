{
  "name": "toefl-practice-system",
  "version": "1.7.4",
  "description": "A focused TOEFL iBT practice and mock exam app.",
  "main": "electron/main.js",
  "type": "module",
    "productName": "Tofu Practice",
  "desktopName": "toefl-practice",
  "author": "anton-bis",
  "license": "MIT",
  "scripts": {
    "dev": "npm run content:manifest && vite",
    "content:manifest": "node scripts/generate-question-manifest.js",
    "content:pull": "node scripts/pull-content.js",
    "content:publish": "node scripts/publish-content.js",
    "build": "npm run content:manifest && vite build && node scripts/check-bundle-size.js",
    "preview": "vite preview",
    "test": "node --test tests/content/content.test.js tests/electron/*.test.js && vitest run",
    "test:watch": "vitest",
    "lint": "eslint src electron scripts tests vite.config.js vitest.config.js obfuscator.config.js --ext .js,.cjs,.vue --max-warnings=0",
    "format": "prettier --write \"{src,electron,scripts,tests}/**/*.{js,cjs,vue,css}\" \"{vite,vitest,obfuscator}.config.js\" .eslintrc.json .prettierrc.json package.json",
    "format:check": "prettier --check \"{src,electron,scripts,tests}/**/*.{js,cjs,vue,css}\" \"{vite,vitest,obfuscator}.config.js\" .eslintrc.json .prettierrc.json package.json",
    "clean": "rm -rf dist build node_modules",
    "electron:dev": "cross-env ELECTRON=true npm run build && electron electron/main.js",
    "electron:prepare": "cross-env ELECTRON=true npm run build && node scripts/obfuscate.js",
    "electron:build": "npm run electron:prepare && electron-builder",
    "electron:pack": "npm run electron:prepare && electron-builder --dir",
    "release:windows": "electron-builder --win nsis --x64 --publish never",
    "release:linux": "electron-builder --linux AppImage --x64 --publish never",
    "release:macos": "electron-builder --mac dmg zip --x64 --arm64 --publish never && node scripts/prepare-mac-update-metadata.js release",
    "release:manifest": "node scripts/prepare-release.js release-files",
    "release:notes": "node scripts/prepare-release-notes.js",
    "perf:baseline": "cross-env ELECTRON=true npm run build && node scripts/measure-electron.js",
    "obfuscate": "node scripts/obfuscate.js"
  },
  "keywords": [
    "toefl",
    "practice",
    "exam",
    "education",
    "frontend",
    "javascript"
  ],
  "dependencies": {
    "electron-updater": "^6.8.9",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.2",
    "brace-expansion@5": "5.0.8",
    "fast-uri": "4.1.1",
    "form-data": "4.0.6",
    "js-yaml": "4.3.0",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@fontsource-variable/roboto": "^5.2.10",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^7.0.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.33.0",
    "fake-indexeddb": "^6.2.5",
    "javascript-obfuscator": "^4.2.2",
    "jsdom": "^24.1.3",
    "pinia": "^3.0.4",
    "prettier": "^3.1.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4",
    "yazl": "^3.3.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=9.0.0"
  },
  "build": {
    "appId": "io.github.antonbis.toeflpractice",
  "productName": "Tofu Practice",
    "executableName": "toefl-practice",
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*",
          "!assets/questions/**",
          "!assets/audio/**"
        ]
      },
      {
        "from": "build/electron",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      },
      "package.json",
      "!node_modules/**/*.map"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icons/icon.png",
      "artifactName": "TOEFL-iBT-Practice-${version}-macos-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico",
      "artifactName": "TOEFL-iBT-Practice-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png",
      "category": "Education",
      "syncDesktopName": true,
      "artifactName": "TOEFL-iBT-Practice-${version}-linux-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/icon.ico",
      "artifactName": "TOEFL-iBT-Practice-${version}-windows-${arch}-setup.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://v6.gh-proxy.org/https://github.com/anton-bis/toefl-app/releases/latest/download",
      "channel": "latest"
    }
  }
}
